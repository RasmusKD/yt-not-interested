{
  "manifest_version": 3,
  "name": "YT Not Interested",
  "version": "1.0.1",
  "description": "One-click Not interested on YouTube, run through YouTube's own handler without opening the menu.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["find.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
